SERVICE_NAME=template-service
VERSION=0.1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=9000
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE_PATH=logs/template-service.log
LOG_OVERWRITE_ON_START=true
API_V1_PREFIX=/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/template_service
FILES_SERVICE_BASE_URL=http://localhost:8001
FILES_SERVICE_DOWNLOAD_PATH_TEMPLATE=/files/{file_id}
FILES_SERVICE_UPLOAD_URL_PATH=/upload
FILES_SERVICE_AUTH_TOKEN=
FILES_SERVICE_TIMEOUT_SECONDS=20
FILES_SERVICE_VERIFY_TLS=true
FILES_SERVICE_UPLOAD_BUCKET=TEMPLATE_DOCUMENTS
FILES_SERVICE_UPLOADER_ID=
TEMPLATE_CACHE_TTL_SECONDS=300
AUTO_CREATE_TABLES=true
